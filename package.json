{
  "name": "aimuse",
  "productName": "AIMuse",
  "version": "0.1.0-alpha.0",
  "description": "Agent-native music, DAW, and sound-design studio",
  "license": "MIT",
  "author": "AIMuse contributors",
  "main": ".vite/build/main.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "require:node24": "node scripts/require-node24.mjs",
    "qa:runtime": "node scripts/require-node24.mjs",
    "qa:headless-restart": "node scripts/qa-headless-restart.mjs",
    "qa:windows-private-root": "node scripts/qa-private-root-windows-integration.mjs",
    "qa:windows-private-root-node-api": "node scripts/qa-private-root-node-api-integration.mjs",
    "prestart": "npm run qa:runtime",
    "start": "electron-forge start",
    "prestart:engine": "npm run qa:runtime",
    "start:engine": "electron-forge start -- --headless",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src packages/core/src tests e2e scripts forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts vitest.config.ts vitest.macos.config.ts vitest.performance.config.ts playwright.config.ts playwright.renderer.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:renderer:headless": "playwright test --config=playwright.renderer.config.ts",
    "test:e2e": "npm run package && npm run test:e2e:only",
    "test:e2e:only": "playwright test",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "preverify": "npm run qa:runtime",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:renderer:headless",
    "native:configure": "node scripts/native-build.mjs configure",
    "native:build": "node scripts/native-build.mjs build",
    "native:test": "node scripts/native-build.mjs test",
    "portability:check": "node scripts/check-portability.mjs",
    "macos:preflight": "node scripts/macos-preflight.mjs",
    "macos:icon": "node scripts/build-macos-icon.mjs",
    "macos:coreaudio-smoke": "node scripts/macos-coreaudio-smoke.mjs",
    "test:macos:headless": "vitest run --config vitest.macos.config.ts",
    "verify:macos": "npm run require:node24 && npm run macos:preflight && npm run portability:check && npm run typecheck && npm run lint && npm run test:macos:headless && npm run native:test",
    "prepackage": "npm run qa:runtime && node scripts/package-platform-preflight.mjs && npm run native:build",
    "package": "electron-forge package",
    "package:artifact": "electron-forge package",
    "postpackage": "node scripts/verify-package.mjs",
    "premake": "npm run qa:runtime && node scripts/package-platform-preflight.mjs && npm run native:build",
    "make": "electron-forge make",
    "pretest:level1:auto": "npm run qa:runtime",
    "test:level1:auto": "node scripts/formal-package-workflow.mjs --level=1",
    "pretest:level2:auto": "npm run qa:runtime",
    "test:level2:auto": "node scripts/formal-package-workflow.mjs --level=2",
    "pretest:level3:auto": "npm run qa:runtime",
    "test:level3:auto": "npm run release:windows",
    "checksums": "node scripts/checksums.mjs",
    "licenses": "node scripts/license-report.mjs",
    "release:windows": "npm run verify && npm run native:test && npm run test:performance && npm audit --omit=dev --audit-level=high && npm run package && npm run test:e2e:only && npm run make && npm run checksums && npm run licenses"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tonejs/midi": "2.0.28",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "archiver": "7.0.1",
    "fflate": "0.8.3",
    "hono": "4.13.0",
    "immer": "11.1.15",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.28.0",
    "music-metadata": "11.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "3.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@aimuse/core": "0.1.0-alpha.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/archiver": "6.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "43.2.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
